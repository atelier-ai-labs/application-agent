{
  "id": "08-opaque-custom-prompt-extraction",
  "kind": "rippling_dom",
  "description": "Opaque custom-prompt extraction via ancestor-sibling candidate walk (shared selector rules).",
  "graders": [
    "deterministic"
  ],
  "input": {
    "cases": [
      {
        "id": "reject-opaque",
        "type": "opaque_token",
        "value": "abc12XYZ99",
        "expected": true
      },
      {
        "id": "accept-prompt-phrase",
        "type": "opaque_token",
        "value": "What is your salary?",
        "expected": false
      },
      {
        "id": "reject-search-label",
        "type": "prompt_text",
        "value": "Search",
        "expected": false
      },
      {
        "id": "accept-salary-prompt",
        "type": "prompt_text",
        "value": "Expected compensation range",
        "expected": true
      },
      {
        "id": "pick-salary-over-search",
        "type": "prompt_candidates",
        "candidates": [
          {
            "text": "Search",
            "containsControl": false
          },
          {
            "text": "What is your expected salary? \u2731",
            "containsControl": false
          }
        ],
        "expectedPrompt": "What is your expected salary?"
      },
      {
        "id": "skip-control-sibling",
        "type": "prompt_candidates",
        "candidates": [
          {
            "text": "Previous question?",
            "containsControl": true
          },
          {
            "text": "opaqueAAAA01",
            "containsControl": false
          }
        ],
        "expectedPrompt": null
      }
    ]
  },
  "expected": {
    "allMustPass": true
  }
}
