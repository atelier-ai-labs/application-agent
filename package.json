{
  "name": "atelier-hq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "career-agent:executor": "vite-node application-agent/automation/executionHost/run.ts",
    "career-agent:runtime": "vite-node application-agent/automation/runtime/run.ts",
    "career-agent:slack": "vite-node application-agent/automation/slack/run.ts",
    "career-agent:import-resume": "vite-node application-agent/automation/resume/run.ts",
    "career-agent:google-auth": "vite-node application-agent/automation/googleAuth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "npm run build && vite-node application-agent/automation/acceptance/run.ts",
    "test:evals": "vite-node evals/run.ts",
    "test:evals:negatives": "vite-node evals/runNegatives.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
