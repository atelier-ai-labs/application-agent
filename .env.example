# NHL uses the verified public dashboard API by default. Set this only when
# pointing local development at another approved dashboard API base URL.
VITE_NHL_API_BASE_URL=

# Quant Intelligence is local-only by default. Set this to the running
# Quant API service root to enable its experiment signal.
VITE_QUANT_API_BASE_URL=

# Public structured job feed used by Career Agent live discovery.
# No credential is required; blank uses the built-in Remotive endpoint.
VITE_REMOTIVE_API_BASE_URL=https://remotive.com/api/remote-jobs

# Optional targeted Lever public job boards. Use comma-separated SITE identifiers
# (for example: acme,another-company). Leave blank to keep Lever disabled.
VITE_LEVER_SITES=

# Lever's public postings endpoint is credential-free. Override only when using
# an approved compatible proxy or regional endpoint.
VITE_LEVER_API_BASE_URL=https://api.lever.co/v0/postings

# Optional targeted Greenhouse public job boards. Use comma-separated board
# tokens (for example: stripe,ramp). Leave blank to keep Greenhouse disabled.
VITE_GREENHOUSE_BOARDS=
# Greenhouse Job Board API is public for GET requests; no credential is needed.
VITE_GREENHOUSE_API_BASE_URL=https://boards-api.greenhouse.io/v1/boards

# Optional bounded broad URL discovery. Set true only when the trusted local
# Node host has ATELIER_BRAVE_SEARCH_API_KEY configured. The key is never a
# VITE_ variable and is never sent to the browser.
VITE_BROAD_DISCOVERY_ENABLED=false

# Loopback-only Node host for real Lever browser-assisted preparation. Start it
# separately with `npm run career-agent:executor`; blank uses 127.0.0.1:8787.
VITE_EXECUTION_HOST_BASE_URL=http://127.0.0.1:8787

# Optional server-side local resume configuration. The browser UI never sends
# filesystem paths; configured artifacts must be inside this root.
ATELIER_RESUME_ROOT=
ATELIER_RESUME_CLOUD_PLATFORM_PATH=
ATELIER_RESUME_FRONTEND_SOFTWARE_PATH=
ATELIER_RESUME_AI_PLATFORM_AGENTIC_PATH=

# Optional local execution-host overrides.
ATELIER_EXECUTION_HOST=127.0.0.1
ATELIER_EXECUTION_PORT=8787
ATELIER_EXECUTION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Keep false for local-only operation. Public binding also requires an explicit
# process-level opt-in and still has no account authentication layer.
ATELIER_EXECUTION_ALLOW_NON_LOOPBACK=false
ATELIER_EXECUTION_HEADLESS=false
ATELIER_EXECUTION_BROWSER_TIMEOUT_MS=15000
ATELIER_EXECUTION_MAX_CONCURRENT=1
ATELIER_EXECUTION_SESSION_TIMEOUT_MS=1800000

# Optional server-only Slack attention delivery. Never prefix these with VITE_
# or commit real token/user values. Socket Mode requires an app-level token.
ATELIER_SLACK_BOT_TOKEN=
ATELIER_SLACK_APP_TOKEN=
ATELIER_SLACK_CHANNEL_ID=
ATELIER_SLACK_ALLOWED_USER_ID=
ATELIER_SLACK_ALLOWED_TEAM_ID=
ATELIER_SLACK_API_BASE_URL=https://slack.com/api

# Optional server-only broad discovery. Brave Search Web API is documented at
# https://api-dashboard.search.brave.com/api-reference/web/search/get. Leave
# the key blank to expose an honest not_configured state. Conservative defaults
# limit this experiment to three queries and thirty references per cycle. Fresh
# responses are reused in memory for five minutes by default.
ATELIER_BRAVE_SEARCH_API_KEY=
ATELIER_BRAVE_SEARCH_API_BASE_URL=https://api.search.brave.com/res/v1/web/search
ATELIER_BRAVE_SEARCH_MAX_QUERIES=3
ATELIER_BRAVE_SEARCH_MAX_RESULTS_PER_QUERY=10
ATELIER_BRAVE_SEARCH_MAX_TOTAL_REFERENCES=30
ATELIER_BRAVE_SEARCH_CACHE_TTL_MS=300000
ATELIER_BRAVE_SEARCH_TIMEOUT_MS=8000
ATELIER_BRAVE_SEARCH_COUNTRY=US
ATELIER_BRAVE_SEARCH_LANGUAGE=en

# Optional server-only Google Sheets tracker configuration. The target was
# verified as the existing spreadsheet "Nate Job Search Tracker" with the
# "Job Tracker" tab. The ID is configuration only; access still requires auth.
# Never prefix these with VITE_ or commit credential/token values.
ATELIER_GOOGLE_SHEET_ID=1_8Jm17zZCOkxcIqi2td3H3uqyyP1tHhjP9fQcKfIQ8k
ATELIER_GOOGLE_SHEET_NAME=Nate Job Search Tracker
ATELIER_GOOGLE_SHEET_TAB=Job Tracker
# Preferred personal mode: set ATELIER_GOOGLE_AUTH_MODE=oauth, place a Google
# Desktop OAuth client JSON outside source control, then run
# `npm run career-agent:google-auth`. The OAuth scope is Sheets-only:
# https://www.googleapis.com/auth/spreadsheets
ATELIER_GOOGLE_AUTH_MODE=oauth
ATELIER_GOOGLE_OAUTH_CLIENT_FILE=.local/google-oauth-client.json
ATELIER_GOOGLE_TOKEN_FILE=.local/google-sheets-token.json
# Explicit legacy alternatives. Select one with ATELIER_GOOGLE_AUTH_MODE when
# more than one credential lane is configured.
ATELIER_GOOGLE_APPLICATION_CREDENTIALS=
ATELIER_GOOGLE_ACCESS_TOKEN=
ATELIER_GOOGLE_SHEETS_TIMEOUT_MS=10000
